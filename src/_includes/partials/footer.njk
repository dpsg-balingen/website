      <img src="/assets/img/logo.png" alt="DPSG Balingen">
      <p>{{ site.longName }}</p>
    </div>
    <div>
      <h3>Anschrift</h3>
      <p>{{ kontakt.anschrift.verein }}<br>{{ kontakt.anschrift.strasse }}<br>{{ kontakt.anschrift.ort }}</p>
