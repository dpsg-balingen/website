<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/assets/img/ci/zeichen-dunkel.svg" width="44" height="44" alt="">
      <span class="brand-text">
        <strong>DPSG Balingen</strong>
        <small>Stamm Heilig Geist</small>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Menü" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {% for item in site.nav %}
          {% if item.children %}
            <li class="nav-item has-children">
              <a href="#" class="nav-parent">{{ item.title }} <svg class="caret" width="10" height="7" viewBox="0 0 10 7" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></a>
              <ul class="submenu">
                {% for c in item.children %}
                  <li><a href="{{ c.url }}" {% if page.url == c.url %}class="active"{% endif %}>{{ c.title }}</a></li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="nav-item">
              <a href="{{ item.url }}" {% if page.url == item.url %}class="active"{% endif %}>{{ item.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
    {#- Versteckt, bis nav.js ihn einschaltet: ohne Skript folgt das
        Farbschema dem Gerät, ein toter Knopf wäre nur verwirrend. -#}
    <button class="farbschema-knopf" type="button" aria-pressed="false" aria-label="Dunkler Modus" title="Dunkler Modus" hidden>
      <svg class="fk-mond" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" fill="currentColor"/></svg>
      <svg class="fk-sonne" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.6" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7"/></g></svg>
    </button>
  </div>
</header>
