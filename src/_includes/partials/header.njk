<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img src="/assets/img/logo.png" alt="DPSG Balingen">
      <span class="brand-text">
        <strong>DPSG Balingen</strong>
        <small>Stamm Heilig Geist</small>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Menü" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {% for item in site.nav %}
          {% if item.children %}
            <li class="nav-item has-children">
              <a href="#" class="nav-parent">{{ item.title }} <svg class="caret" width="10" height="7" viewBox="0 0 10 7" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></a>
              <ul class="submenu">
                {% for c in item.children %}
                  <li><a href="{{ c.url }}" {% if page.url == c.url %}class="active"{% endif %}>{{ c.title }}</a></li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="nav-item">
              <a href="{{ item.url }}" {% if page.url == item.url %}class="active"{% endif %}>{{ item.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
