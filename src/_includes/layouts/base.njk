<!doctype html>
<html lang="de" data-form="stamp"{% if stufe %} data-stufe="{{ stufe }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }} · {{ site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/ci/favicon-512-dunkel.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }} · {{ site.name }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/assets/img/ci/favicon-512-dunkel.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/ci/favicon-32-dunkel.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/img/ci/favicon-192-dunkel.png">
<link rel="apple-touch-icon" href="/assets/img/ci/favicon-192-dunkel.png">
<meta name="theme-color" content="#2a3d7c">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
{% if banner.nachricht and (banner.gueltig_bis | istGueltig) %}
<div class="ankuendigung">
  <span>{{ banner.nachricht }}</span>
  {% if banner.link %}<a class="ankuendigung-link" href="{{ banner.link }}">{{ banner.link_text }} →</a>{% endif %}
</div>
{% endif %}
{% include "partials/header.njk" %}

{#- Kopfbild: Stufen-Seiten über "stufe", alle anderen über den Dateinamen.
    Aktionsseiten (src/aktionen/) nehmen das Bild ihrer Kachel im
    Programmband. Steht in bilder.yaml nichts, bleibt headerBild leer und
    die Seite zeigt wie bisher nur die Überschrift. -#}
{%- set headerBild = "" -%}
{%- if not heroTitle -%}
  {%- if stufe -%}
    {%- set headerBild = bilder.stufen[stufe] -%}
  {%- else -%}
    {%- set headerBild = bilder.seiten[page.fileSlug] or (bilder.programm | programmBild(page.fileSlug)) -%}
  {%- endif -%}
{%- endif -%}
{#- Alter kommt aus gruppenstunden.yaml. Nur wo es dort keinen Eintrag
    gibt (Leiter, Altrover), zählt ein "alter:" im Seitenkopf. -#}
{%- set alter = (gruppenstunden.gruppen | alterFuerStufe(stufe)) or alter -%}

{% if heroTitle %}
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <h1>{{ heroTitle }}</h1>
      {% if heroSubtitle %}<p class="hero-sub">{{ heroSubtitle }}</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<main class="site-main">
  <div class="container">
    {% if sidebar != false %}
    <div class="layout">
      <article class="content prose">
        {% if headerBild %}{% include "partials/seitenheader.njk" %}
        {% elif not heroTitle %}<h1 class="page-title">{{ title }}</h1>{% endif %}
        {{ content | safe }}
        {% if page.url.startsWith("/aktionen/") %}{% include "partials/aktionen-weiter.njk" %}{% endif %}
      </article>
      {% include "partials/sidebar.njk" %}
    </div>
    {% else %}
      {{ content | safe }}
    {% endif %}
  </div>
</main>

{% include "partials/footer.njk" %}
<script src="/assets/js/nav.js" defer></script>
</body>
</html>
